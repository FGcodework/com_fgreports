<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="basic">
        <field
            name="id"
            type="number"
            class="readonly"
            label="JGLOBAL_FIELD_ID_LABEL"
            default="0"
            readonly="true"
        />

        <field
            name="title"
            type="text"
            label="COM_FGREPORTS_FIELD_TITLE_LABEL"
            required="true"
            size="40"
        />

        <field
            name="alias"
            type="text"
            label="COM_FGREPORTS_FIELD_ALIAS_LABEL"
            description="COM_FGREPORTS_FIELD_ALIAS_DESC"
            hint="COM_FGREPORTS_FIELD_ALIAS_HINT"
            size="40"
        />

        <field
            name="description"
            type="textarea"
            label="COM_FGREPORTS_FIELD_DESCRIPTION_LABEL"
            rows="3"
            cols="40"
        />

        <field
            name="sql_script"
            type="textarea"
            label="COM_FGREPORTS_FIELD_SQL_LABEL"
            description="COM_FGREPORTS_FIELD_SQL_DESC"
            required="true"
            filter="raw"
            rows="18"
            cols="80"
            class="fgreports-sql-editor"
        />

        <field
            name="published"
            type="list"
            label="JSTATUS"
            default="0"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            default="2"
        />

        <field
            name="cache_ttl"
            type="number"
            label="COM_FGREPORTS_FIELD_CACHE_TTL_LABEL"
            description="COM_FGREPORTS_FIELD_CACHE_TTL_DESC"
            default="0"
            min="0"
            max="1440"
        />

        <field
            name="page_limit"
            type="number"
            label="COM_FGREPORTS_FIELD_PAGE_LIMIT_LABEL"
            description="COM_FGREPORTS_FIELD_PAGE_LIMIT_DESC"
            default="0"
            min="0"
            max="1000"
        />

        <field
            name="stack_mobile"
            type="radio"
            layout="joomla.form.field.radio.switcher"
            default="1"
            label="COM_FGREPORTS_FIELD_STACK_MOBILE_LABEL"
            description="COM_FGREPORTS_FIELD_STACK_MOBILE_DESC"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field
            name="table_css_class"
            type="text"
            label="COM_FGREPORTS_FIELD_TABLE_CSS_CLASS_LABEL"
            description="COM_FGREPORTS_FIELD_TABLE_CSS_CLASS_DESC"
            size="40"
        />

        <field
            name="enable_sorting"
            type="radio"
            layout="joomla.form.field.radio.switcher"
            default="1"
            label="COM_FGREPORTS_FIELD_ENABLE_SORTING_LABEL"
            description="COM_FGREPORTS_FIELD_ENABLE_SORTING_DESC"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field
            name="ordering"
            type="text"
            label="JFIELD_ORDERING_LABEL"
            class="readonly"
            readonly="true"
            default="0"
        />
    </fieldset>

    <fieldset name="jmetadata" label="JGLOBAL_FIELDSET_PUBLISHING" addfieldpath="/libraries/src/Form/Field">
        <field
            name="created"
            type="calendar"
            label="JGLOBAL_FIELD_CREATED_LABEL"
            format="%Y-%m-%d %H:%M:%S"
            filter="user_utc"
            readonly="true"
        />

        <field
            name="created_by"
            type="user"
            label="JGLOBAL_FIELD_CREATED_BY_LABEL"
            readonly="true"
        />

        <field
            name="modified"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            format="%Y-%m-%d %H:%M:%S"
            filter="user_utc"
            readonly="true"
        />

        <field
            name="modified_by"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            readonly="true"
        />
    </fieldset>
</form>
